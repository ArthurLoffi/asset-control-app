# Default: /api. In production, serve /api through your reverse proxy or set
# this to an API URL that allows the frontend origin through CORS.
VITE_API_BASE_URL=/api

# Optional company logo. Use an https:// URL, a public path such as /logo.png,
# or a file stored in src/widgets/header/assets.
VITE_COMPANY_LOGO=src/widgets/header/assets/logo.png

# Optional login background. Use an https:// URL or a public asset path.
VITE_LOGIN_BACKGROUND=/login-hero.jpg
